# Cloudflare Pages response headers (VTL-95)
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Vite puts a content hash in every file name it writes to /assets/, so a
# changed file always has a new name and the old one can be cached for a year.
# Rules apply in order: the broad rule first, then the exceptions below it.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Files copied from public/assets/ keep their names, so they keep the default
# short cache. Every file in public/assets/ needs an entry here: the test in
# src/utils/__tests__/cacheHeaders.test.ts enforces it.
/assets/vt-liveview-dark.svg
  ! Cache-Control
  Cache-Control: public, max-age=14400, must-revalidate

/assets/vt-liveview-light.svg
  ! Cache-Control
  Cache-Control: public, max-age=14400, must-revalidate

/assets/vt-liveview-vintage.png
  ! Cache-Control
  Cache-Control: public, max-age=14400, must-revalidate

/assets/vt-liveview-vintage.svg
  ! Cache-Control
  Cache-Control: public, max-age=14400, must-revalidate
