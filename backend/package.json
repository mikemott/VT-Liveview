{
  "name": "vt-liveview-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "e2e:server": "node --import tsx src/test/e2e-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "format": "prettier --write src \"*.{js,ts}\" package.json tsconfig.json",
    "format:check": "prettier --check src \"*.{js,ts}\" package.json tsconfig.json"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@as-integrations/fastify": "^2.1.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.38.0",
    "fastify": "^4.28.1",
    "graphql": "^16.9.0",
    "node-cron": "^3.0.3",
    "postgres": "^3.4.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^25.0.8",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^4.0.17",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.17"
  }
}
