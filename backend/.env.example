# Backend environment (validated in src/types/env.ts). Copy to backend/.env.
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Production CORS: comma-separated origins
# ALLOWED_ORIGINS=https://vtliveview.com

# Required by NOAA's terms of service (User-Agent)
CONTACT_EMAIL=you@example.com

# ADMIN_TOKEN=            # /admin/clear-cache in production
# NOAA_CDO_TOKEN=         # NOAA Climate Data Online (historical weather)
# AIRNOW_API_KEY=         # EPA AirNow (air quality); without it the AQI routes answer "not configured"
# AFDC_API_KEY=           # DOE AFDC (EV chargers); falls back to DEMO_KEY
# RATE_LIMIT_MAX=300      # REST requests per client IP per minute

# Optional history database
# DATABASE_URL=postgres://...
# DATABASE_MODE=postgres
# ENABLE_COLLECTOR=true

# SENTRY_DSN=
