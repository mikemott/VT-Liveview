{
  "name": "weather-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "format": "prettier --write src e2e scripts .github \"*.{js,ts,html}\" package.json tsconfig.json tsconfig.e2e.json",
    "format:check": "prettier --check src e2e scripts .github \"*.{js,ts,html}\" package.json tsconfig.json tsconfig.e2e.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@bybas/weather-icons": "^2.0.0",
    "@protomaps/basemaps": "^5.7.0",
    "@tanstack/react-query": "^5.90.16",
    "graphql-request": "^7.4.0",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^5.15.0",
    "pmtiles": "^4.3.2",
    "protomaps-themes-base": "^4.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.2.4",
    "vitest": "^4.0.17"
  }
}
